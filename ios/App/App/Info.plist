<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Info.plist pour Vootify (Capacitor / iOS)

  Clés importantes pour le stockage hors-ligne dans l'app Fichiers iPhone :
    - UIFileSharingEnabled          : rend le dossier Documents visible dans
                                      Fichiers → Sur mon iPhone → Vootify
    - LSSupportsOpeningDocumentsInPlace : permet d'ouvrir les fichiers MP3 /
                                      images directement depuis l'app Fichiers

  Après avoir modifié ce fichier, exécutez :
    npx cap sync ios
  puis compilez depuis Xcode.
-->
<plist version="1.0">
<dict>
	<!-- Identité de l'application -->
	<key>CFBundleDevelopmentRegion</key>
	<string>fr</string>
	<key>CFBundleDisplayName</key>
	<string>Vootify</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>

	<!-- Interface utilisateur -->
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<!-- ===================================================
	     STOCKAGE HORS-LIGNE — APP FICHIERS IPHONE
	     ===================================================
	     Ces deux clés permettent au dossier "Vootify Music"
	     (créé par @capacitor/filesystem dans Documents/)
	     d'apparaître dans l'application Fichiers d'iOS.
	     ================================================= -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>

	<!-- Sécurité réseau -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>

	<!-- Autorisation micro (si besoin) -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Vootify n'utilise pas le microphone.</string>
</dict>
</plist>
